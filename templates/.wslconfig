# .wslconfig - global WSL 2 settings, applied to every distribution.
# Host-side file on Windows: %UserProfile%\.wslconfig
# (C:\Users\<you>\.wslconfig). There is no default file; create it if needed.
# Only affects WSL 2 distributions.
# After editing, restart WSL so changes apply:  wsl --shutdown
# Reference: https://learn.microsoft.com/en-us/windows/wsl/wsl-config
#
# This file is an EXAMPLE. Everything below is commented out except the two
# options recommended for a headless X Linux distribution. Windows also offers
# a "WSL Settings" application that edits the same settings. install.ps1 only
# prints guidance and never overwrites an existing .wslconfig; use its
# -CreateWslConfig switch to place a starter file when none exists.

[wsl2]

# RAM available to the WSL 2 VM. Default: 50% of the physical memory.
# X Linux for WSL is headless, so a smaller value leaves more RAM to Windows.
# memory=4GB

# Logical processors available to the WSL 2 VM. Default: all logical CPUs.
# processors=4

# GUI application support (WSLg). X Linux for WSL ships NO GUI and NO Hyprland
# or compositor, so WSLg is not used. Keep GUI apps disabled to save
# resources; set to true only if you need to run Linux GUI applications.
guiApplications=false

# Swap for the WSL 2 VM. Use 0 to disable the swap file.
# swap=2GB

# Host networking modes for WSL 2 (nat, mirrored, ...). Default is NAT; leave
# it alone unless you need mirrored networking.
# networkingMode=mirrored

[experimental]

# Automatic memory reclamation on Windows 11. Values: disabled | gradual |
# dropCache. "dropCache" reclaims cached memory immediately when possible and
# is the default on recent WSL builds.
autoMemoryReclaim=dropCache

# Newly created VHDs are sparse, so each distribution only uses the disk it
# actually fills. Apply on the host before the first import so the X Linux
# VHD is created sparse.
sparseVhd=true
